# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored — your secrets never leave your machine.

# --- Tesla Fleet API credentials ---------------------------------------
# Register a developer application at https://developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# Fleet API region: na (North America), eu (Europe), cn (China)
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback
# Where OAuth tokens are stored locally (file is created with mode 600)
TESLA_TOKEN_FILE=~/.tcc/tokens.json

# --- Your vehicles -------------------------------------------------------
# Format: name=VIN, one entry per car, comma-separated.
TCC_VEHICLES=Daily=5YJ3E1EA0KF000001,Second=7SAYGDEE5PF000002

# --- Dog Mode watch ------------------------------------------------------
# Alert when the cabin drifts more than this (°C) from the baseline.
# Baseline = TCC_DOG_SETPOINT_C if set, else the inside temperature when
# Dog Mode first became active.
TCC_DOG_TEMP_DRIFT_C=3.0
# Alert when battery drops below this percent while Dog Mode is on
# (Dog Mode dies with the battery).
TCC_DOG_SOC_MIN=20
# Optional: the temperature Dog Mode should hold (e.g. the value you set on
# the touchscreen). If left empty, the baseline is the first observed
# cabin temperature after Dog Mode becomes active.
TCC_DOG_SETPOINT_C=

# --- Notifications -------------------------------------------------------
# Free push alert to a SECOND person when something goes wrong
# (ntfy.sh — no account needed). Subscribe to the same topic on the
# second phone (partner, friend, pet sitter) with the ntfy app.
# The topic is the secret: pick something unguessable, e.g.
# TCC_NTFY_TOPIC=tesla-dog-$(openssl rand -hex 8)
TCC_NTFY_TOPIC=

# --- Runtime ---------------------------------------------------------------
TCC_STATE_FILE=~/.tcc/dogmode_guardian_state.json
# How often to check (seconds). 300 = 5 minutes — a pet-safety app needs a
# tighter cadence than 15 minutes, but each check is a billed Fleet API
# read. Run the daemon ONLY while your pet is actually in the car — a
# 1-hour errand costs about $0.02. See "Expected API cost".
TCC_POLL_INTERVAL_SECONDS=300
# Dry run: log what WOULD happen without sending any alerts.
TCC_DRY_RUN=false
